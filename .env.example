# Copia este archivo como .env y cambia los valores. El archivo .env NUNCA se sube a GitHub.
# Estos valores son de ejemplo: no son credenciales reales.

# --- Base de datos de Docker Compose ---
POSTGRES_USER=cleanpro
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=cleanpro

# --- Aplicación ---
# Sin Docker, si no defines DATABASE_URL se usa SQLite en el archivo cleanpro.db.
# Con PostgreSQL: postgresql+psycopg://USUARIO:CONTRASENA@HOST:5432/BASE
DATABASE_URL=sqlite:///./cleanpro.db
APP_ENV=desarrollo
CARGAR_DATOS_DEMO=true
ZONA_HORARIA=America/Monterrey
